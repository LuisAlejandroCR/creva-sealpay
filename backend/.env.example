CREVA_API_URL=https://placeholder-creva-api.example.com
CREVA_SERVICE_REFRESH_TOKEN=
HEDERA_NETWORK=hedera:testnet
FACILITATOR_URL=https://api.testnet.blocky402.com
FACILITATOR_AUTH_TOKEN=
FACILITATOR_FEE_PAYER=0.0.7162784
X402_VERSION=2
PAY_TO_ADDRESS=0.0.0000000
PAYMENT_ASSET=0.0.0
REPORT_PRICE_ATOMIC=10000000
VERIFY_PRICE_ATOMIC=5000000
WORLD_API_KEY=
WORLD_APP_ID=
WORLD_VERIFY_URL=https://developer.world.org/api/v4/verify
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=staging
HEDERA_PAYER_ACCOUNT_ID=
HEDERA_PAYER_PRIVATE_KEY=
ENS_OWNER_ADDRESS=
ENS_OWNER_PRIVATE_KEY=
ALCHEMY_API_KEY=
ARC_RPC_URL=
ARC_NETWORK=
ARC_SIGNER_ADDRESS=
ARC_SIGNER_PRIVATE_KEY=
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/creva-attestations/<version>
CIRCLE_AGENT_STACK_API_KEY=
# Chainlink regulatory-alert upkeep (contracts/src/RegulatoryAlertRegistry.sol). The address is
# emitted by contracts/script/DeployRegulatoryAlertRegistry.s.sol; REGULATORY_REPORTER is the
# Chainlink Functions consumer allowed to call reportPending (defaults to the deploy signer).
REGULATORY_ALERT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
REGULATORY_REPORTER=
BAZANTIC_GATEWAY_URL=
BAZANTIC_MCP_TOKEN=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Private business-logic service (creva-business-logic) ─────────────────────
# The deployed Creva core for score / calculator / recommendations / collateral /
# declarations / transactions. Missing => those routes answer "core_unavailable".
BUSINESS_LOGIC_URL=
# Fixed service bearer, compared with timingSafeEqual on the service side. The human
# sets this to the same value configured as CORE_SERVICE_TOKEN in creva-business-logic.
CORE_SERVICE_TOKEN=

# ── Clerk (backend validates the mobile app's session token itself) ──────────
# Either the JWKS URL or the issuer is enough (well-known path derives from the issuer).
CLERK_JWKS_URL=
CLERK_ISSUER=
# Optional: only enforced when set (single-app instances leave it blank).
CLERK_AUTHORIZED_PARTY=
# Svix signing secret (whsec_...) for POST /webhooks/clerk. Missing => the route refuses deliveries.
CLERK_WEBHOOK_SECRET=

# ── Supabase (SAME project as creva_finance — clerk_identities lives there) ───
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Ledger Key Ring backend for the secrets above. When KEY_RING_ENABLED=true the
# gateway decrypts KEY_RING_SECRETS_FILE via `wallet-cli ring decrypt` at startup
# and uses those values for CREVA_SERVICE_REFRESH_TOKEN, FACILITATOR_AUTH_TOKEN,
# HEDERA_PAYER_PRIVATE_KEY, WORLD_API_KEY, ARC_SIGNER_PRIVATE_KEY; any key missing
# from the blob falls back to the plain env var above. See docs/integrations/ledger-keyring.md.
KEY_RING_ENABLED=false
KEY_RING_CLI=wallet-cli
KEY_RING_KEY_NAME=creva-sealpay
KEY_RING_SECRETS_FILE=secrets.env.enc
