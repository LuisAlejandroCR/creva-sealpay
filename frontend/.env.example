EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# World Selfie Check (no Orb required). Missing app id degrades the onboarding
# flow to identity_unavailable instead of crashing.
EXPO_PUBLIC_WORLD_APP_ID=
EXPO_PUBLIC_WORLD_ACTION_ID=selfie-check-onboarding
# Demo-scoped Hedera testnet signer for the x402 payment retry in QueryScreen.tsx
# (app/features/query/hederaPayment.ts). Testnet-only, openly a shared demo key — never a real
# user's wallet. Paste the same value already used as HEDERA_PAYER_ACCOUNT_ID/
# HEDERA_PAYER_PRIVATE_KEY in gateway/.env if reusing that funded account, or a separate funded
# testnet account. Missing either var surfaces as a real "no demo signer configured" error.
EXPO_PUBLIC_GATEWAY_URL=http://localhost:8787
EXPO_PUBLIC_HEDERA_DEMO_ACCOUNT_ID=
EXPO_PUBLIC_HEDERA_DEMO_PRIVATE_KEY=

# --- Privy embedded wallet: ADDITIVE, optional (app/features/wallet/**). ---
# With EXPO_PUBLIC_PRIVY_APP_ID unset the payment flow is byte-for-byte the demo signer above;
# Privy never replaces it. To actually enable the "Billetera Privy" option you also need to
# install the SDK (see docs/integrations/privy-hedera.md) and set a spending policy below.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Spending policy for the Privy B2B wallet, in tinybar (10^-8 HBAR). BOTH required for privy mode.
EXPO_PUBLIC_PRIVY_MONTHLY_CAP_TINYBAR=
EXPO_PUBLIC_PRIVY_PER_PAYMENT_CAP_TINYBAR=
# Hedera JSON-RPC Relay for defineChain(296) / Privy supportedChains. Defaults to the public
# Hashio testnet relay when unset.
EXPO_PUBLIC_HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
